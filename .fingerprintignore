# EAS rewrites these during every build (version bump, signing profiles),
# so they must not change the runtime fingerprint.
ios/*/Info.plist
ios/*.xcodeproj/project.pbxproj
ios/*/Supporting/Expo.plist
# Machine-local (gitignored) and removed by EAS before the build.
ios/.xcode.env.local
# Regenerated by pod install on the builder. Native dependency changes are
# already in the fingerprint through node_modules and autolinking.
ios/Podfile.lock
ios/*/PrivacyInfo.xcprivacy
